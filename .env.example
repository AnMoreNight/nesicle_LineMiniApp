# --- Database ---
DATABASE_URL="postgresql://nesicle:nesicle_dev_password@localhost:5432/nesicle"

# --- apps/api ---
API_PORT=4000
JWT_SECRET="dev-only-change-me-referrer-jwt-secret"
ADMIN_JWT_SECRET="dev-only-change-me-admin-jwt-secret"
# Set to "true" to enable POST /api/auth/dev-login (mock LINE identity picker).
# Must be unset/false in production.
ALLOW_DEV_LOGIN=true
# Web origins allowed to call the API with credentials
CORS_ORIGINS="http://localhost:3000,http://localhost:3011"
# Seeded admin console login (created by db:seed)
SEED_ADMIN_EMAIL="admin@nesicle.jp"
SEED_ADMIN_PASSWORD="ChangeMe123!"
# LINE MINI App channel IDs whose LINE login tokens are accepted, comma-separated. Each internal
# channel (Published / Review / Developing) has its own ID, e.g. "2012395295,2012395294,2012395293".
LINE_LOGIN_CHANNEL_ID=""
# LINE Messaging API channel access token (a separate channel from LINE Login), used to push
# status-change notifications to referrers. Leave blank to skip sending (notifications are only logged).
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=""
# Amazon SES: application-received emails to applicants. Leave MAIL_FROM blank to skip sending
# (emails are only logged). The sender must be an SES-verified address or domain identity.
MAIL_FROM=""
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- apps/liff ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
# Published LIFF ID. Leave blank in local dev to fall back to the dev login screen.
NEXT_PUBLIC_LIFF_ID=""
# LIFF IDs of the Review / Developing internal channels. Their endpoint URLs in LINE Developers end
# with ?env=review / ?env=dev, which makes the app initialise LIFF with these IDs instead.
NEXT_PUBLIC_LIFF_ID_REVIEW=""
NEXT_PUBLIC_LIFF_ID_DEV=""

# --- apps/admin ---
ADMIN_NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
