# --- Database ---
DATABASE_URL="postgresql://nesicle:nesicle_dev_password@localhost:5432/nesicle"

# --- apps/api ---
API_PORT=4000
JWT_SECRET="dev-only-change-me-referrer-jwt-secret"
ADMIN_JWT_SECRET="dev-only-change-me-admin-jwt-secret"
# Set to "true" to enable POST /api/auth/dev-login (mock LINE identity picker).
# Must be unset/false in production.
ALLOW_DEV_LOGIN=true
# Web origins allowed to call the API with credentials
CORS_ORIGINS="http://localhost:3000,http://localhost:3011"
# Seeded admin console login (created by db:seed)
SEED_ADMIN_EMAIL="admin@nesicle.jp"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# --- apps/liff ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
# Leave blank in local dev to fall back to the dev login screen.
NEXT_PUBLIC_LIFF_ID=""

# --- apps/admin ---
ADMIN_NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
