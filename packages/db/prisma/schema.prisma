generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CaseStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum ProgressStatus {
  APPLIED
  INTERVIEWING
  CONTRACTED
  INELIGIBLE
}

enum RewardStatus {
  UNCONFIRMED
  CONFIRMED
  PAID
}

enum ConsentSubjectType {
  REFERRER
  APPLICANT
}

enum ConsentDocumentType {
  TERMS
  PRIVACY
}

enum BankAccountType {
  ORDINARY
  CHECKING
}

/// 紹介者への振込申請の状態
enum PayoutRequestStatus {
  PENDING
  PAID
}

/// 報酬の受取方法。初期リリースは銀行振込のみだが、将来的に PayPay ポイントや
/// デジタルギフト等を追加できるよう、値を増やすだけで対応できる形にしておく。
enum PayoutMethod {
  BANK_TRANSFER
}

/// LINEユーザー情報 (紹介者としてログインした人物)
model User {
  id          String   @id @default(cuid())
  lineUserId  String   @unique
  displayName String
  pictureUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  referrerProfile     ReferrerProfile?
  referralLinks       ReferralLink[]
  referralSelections  ReferralSelection[]
  payoutRequests      PayoutRequest[]

  @@map("users")
}

/// 紹介者プロフィール
model ReferrerProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  fullName   String   @default("")
  phone      String   @default("")
  email      String   @default("")
  postalCode String   @default("")
  address    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount BankAccount?

  @@map("referrer_profiles")
}

/// 振込先情報
model BankAccount {
  id                String          @id @default(cuid())
  referrerProfileId String          @unique
  bankName          String
  branchName        String
  accountType       BankAccountType @default(ORDINARY)
  accountNumber     String
  accountHolder     String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  referrerProfile ReferrerProfile @relation(fields: [referrerProfileId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

/// 掲載企業
model Company {
  id           String   @id @default(cuid())
  name         String
  contactName  String   @default("")
  contactEmail String   @default("")
  contactPhone String   @default("")
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cases Case[]

  @@map("companies")
}

/// 案件
model Case {
  id                String     @id @default(cuid())
  companyId         String
  title             String
  category          String
  area              String
  summary           String
  description       String
  eligibilityNotes  String     @default("")
  ineligibleNotes   String     @default("")
  rewardTimingNotes String     @default("")
  rewardLabel       String
  rewardAmount      Int
  status            CaseStatus @default(DRAFT)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  company            Company              @relation(fields: [companyId], references: [id])
  referralLinkCases  ReferralLinkCase[]
  applications       Application[]
  referralSelections ReferralSelection[]

  @@map("cases")
}

/// 紹介者が「紹介URL発行」前に選択中(チェック中)の案件。サーバー側で永続化し、
/// ブラウザ/端末をまたいでも選択状態が保持されるようにする。
model ReferralSelection {
  id        String   @id @default(cuid())
  userId    String
  caseId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId])
  @@map("referral_selections")
}

/// 紹介URL (紹介者と、束ねた案件群を紐付ける)
model ReferralLink {
  id         String   @id @default(cuid())
  code       String   @unique
  referrerId String
  createdAt  DateTime @default(now())

  referrer     User               @relation(fields: [referrerId], references: [id])
  cases        ReferralLinkCase[]
  applications Application[]

  @@map("referral_links")
}

/// 紹介URL ⇔ 案件 の多対多結合
model ReferralLinkCase {
  id             String @id @default(cuid())
  referralLinkId String
  caseId         String

  referralLink ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  case         Case         @relation(fields: [caseId], references: [id])

  @@unique([referralLinkId, caseId])
  @@map("referral_link_cases")
}

/// 紹介された申込者 (1回の申込フォーム送信 = 1レコード。複数案件に同時申込しても1件)
model Applicant {
  id         String   @id @default(cuid())
  // 申込者に案内するお問い合わせ番号の連番 (表示は formatInquiryNumber で "OP-000123" 形式)
  inquiryNumber Int   @unique @default(autoincrement())
  fullName   String
  birthDate  DateTime
  postalCode String   @default("")
  address    String
  phone      String
  email      String
  notes      String   @default("")
  createdAt  DateTime @default(now())

  applications Application[]

  @@map("applicants")
}

/// 申込レコード (申込者 × 案件 で1件。進捗・成果・報酬・支払状況を保持)
model Application {
  id               String         @id @default(cuid())
  applicantId      String
  caseId           String
  referralLinkId   String
  progressStatus   ProgressStatus @default(APPLIED)
  rewardStatus     RewardStatus   @default(UNCONFIRMED)
  rewardAmount     Int?
  ineligibleReason String?
  internalNotes    String         @default("")
  // 同じ申込(Applicant)内での連番。お問い合わせ番号は申込ごとの番号 + この連番 ("OP-000123-2")
  // で、案件ごとに企業・進捗が別になるため1件ずつ固有の番号にする。
  inquirySeq       Int            @default(1)
  // 紹介者(パートナー)がワンタッチで行う「完了報告」の日時。これ自体は報酬確定を意味せず、
  // 運営が掲載企業へ成果確認を行うきっかけとなるシグナル。null なら未報告。
  referrerReportedAt DateTime?
  // この申込の報酬がどの振込申請にまとめられたか。null ならまだ未申請。
  payoutRequestId  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  applicant     Applicant      @relation(fields: [applicantId], references: [id])
  case          Case           @relation(fields: [caseId], references: [id])
  referralLink  ReferralLink   @relation(fields: [referralLinkId], references: [id])
  payoutRequest PayoutRequest? @relation(fields: [payoutRequestId], references: [id])

  @@unique([applicantId, inquirySeq])
  @@map("applications")
}

/// 紹介者からの報酬受取申請。完了報告 + 運営側の成果確認が完了し報酬が確定した申込だけを
/// まとめて申請できる。受取方法(method)は今は銀行振込のみだが、将来 PayPay ポイントや
/// デジタルギフト等を追加しやすいよう enum で持たせてある。
model PayoutRequest {
  id          String              @id @default(cuid())
  userId      String
  amount      Int
  method      PayoutMethod        @default(BANK_TRANSFER)
  status      PayoutRequestStatus @default(PENDING)
  requestedAt DateTime            @default(now())
  paidAt      DateTime?

  user         User          @relation(fields: [userId], references: [id])
  applications Application[]

  @@map("payout_requests")
}

/// 規約同意情報
model ConsentRecord {
  id           String              @id @default(cuid())
  subjectType  ConsentSubjectType
  subjectId    String
  documentType ConsentDocumentType
  version      String
  agreedAt     DateTime            @default(now())

  @@map("consent_records")
}

/// 運営管理者アカウント
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}
